# ==============================================================================
# M20 Fine Fragrances — Backend Environment Configuration Example (.env.example)
# ==============================================================================
# Copy this file to .env and fill in the values for your specific environment.
# DO NOT commit real secrets or production keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# PORT: Port number for the Express server to listen on.
# Usage: Server listening port.
# Status: Optional (Defaults to 5000 if omitted).
# Source: Any free local port (5000 is standard).
PORT=5000

# NODE_ENV: Node environment mode ('development', 'production', or 'test').
# Usage: Controls error details, logging levels, rate limiting, and optimizations.
# Status: Required.
# Source: Set to 'development' locally, 'production' on deployment servers.
#         In production the server refuses to start without MONGO_URI and a JWT_SECRET of 32+ chars,
#         and it will NOT fall back to a local MongoDB.
NODE_ENV=development

# CORS_ORIGIN: Allowed origins for Cross-Origin Resource Sharing.
# Usage: Protects API from unauthorized web domains in production.
# Status: Optional in development ('*'). REQUIRED in production.
# Source: Comma-separated list of the store AND dashboard domains, e.g.
#         'https://m20fragrance.store,https://www.m20fragrance.store,https://admin.m20fragrance.store'
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# MONGO_URI: MongoDB connection string URI.
# Usage: Connection string for Mongoose database connection.
# Status: Required.
# Source: Local MongoDB instance ('mongodb://127.0.0.1:27017/elan_fragrance')
#         or MongoDB Atlas cloud connection URI ('mongodb+srv://<user>:<password>@cluster.mongodb.net/elan_fragrance').
MONGO_URI=mongodb://127.0.0.1:27017/elan_fragrance

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens.
# Usage: Authenticates customers, admin staff, and manages bearer sessions.
# Status: Required in production.
# Source: Generate a strong random 64-character string using:
#         node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# JWT_EXPIRES_IN: Lifetime of issued JWT tokens.
# Usage: Expiration duration format (e.g. '7d', '30d', '24h').
# Status: Optional (Defaults to '30d').
# Source: Standard time format string.
JWT_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 4. CLOUDINARY (Media & Image Uploads)
# ------------------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME: Cloudinary cloud identity name.
# Usage: Uploading product images, branding assets, and payment receipts.
# Status: Optional for basic local testing (fallback URL active), Required for live uploads.
# Source: Cloudinary Dashboard (https://cloudinary.com) -> Account Details.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# CLOUDINARY_API_KEY: Cloudinary public API key.
# Usage: Authenticates upload requests.
# Status: Required if Cloudinary is used.
# Source: Cloudinary Dashboard -> API Keys.
CLOUDINARY_API_KEY=your_cloudinary_api_key

# CLOUDINARY_API_SECRET: Cloudinary private API secret.
# Usage: Signing upload requests securely from the backend.
# Status: Required if Cloudinary is used.
# Source: Cloudinary Dashboard -> API Keys.
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. FAWATERK (Online Payment Gateway)
# ------------------------------------------------------------------------------
# FAWATERK_API_KEY: Fawaterk API authentication vendor key.
# Usage: Generating payment invoices, processing credit/debit card transactions online.
# Status: Optional (Only needed if enabling online card payments; Vodafone Cash and InstaPay work via manual transfer receipts).
# Source: Fawaterk Merchant Dashboard (https://fawaterk.com) -> Integration Settings.
FAWATERK_API_KEY=your_fawaterk_api_key

# FAWATERK_BASE_URL: Fawaterk API endpoint URL.
# Usage: Staging vs Production payment gateway routing.
# Status: Optional (Defaults to 'https://staging.fawaterk.com/api/v2').
# Source: 'https://staging.fawaterk.com/api/v2' for testing, 'https://app.fawaterk.com/api/v2' for live.
FAWATERK_BASE_URL=https://staging.fawaterk.com/api/v2

# FAWATERK_WEBHOOK_SECRET: Secret for verifying webhook callbacks.
# Usage: Validates authenticity of payment status webhook notifications from Fawaterk.
# Status: Optional (Required in production for automated callback verification).
# Source: Fawaterk Dashboard -> Webhook Settings.
FAWATERK_WEBHOOK_SECRET=your_fawaterk_webhook_secret

# FAWATERK_REDIRECT_URL: Customer redirection URL after payment completion.
# Usage: Where customer's browser returns after entering card details.
# Status: Optional (Defaults to storefront checkout success page).
# Source: Frontend URL (e.g. 'http://localhost:5173/checkout/success' or 'https://m20fragrance.store/checkout/success').
FAWATERK_REDIRECT_URL=http://localhost:5173/checkout/success

# ------------------------------------------------------------------------------
# 6. EMAIL SERVICE (Nodemailer / SMTP)
# ------------------------------------------------------------------------------
# Note: Both SMTP_* and EMAIL_* naming conventions are fully supported.

# SMTP_HOST / EMAIL_HOST: SMTP server hostname.
# Usage: Sending customer OTP codes, order confirmations, and notifications.
# Status: Optional (Defaults to 'smtp.gmail.com').
# Source: From your mail provider (e.g. 'smtp.gmail.com', 'smtp.mailgun.org', 'smtp-relay.brevo.com').
SMTP_HOST=smtp.gmail.com
EMAIL_HOST=smtp.gmail.com

# SMTP_PORT / EMAIL_PORT: SMTP connection port.
# Usage: Connection port for SMTP.
# Status: Optional (Defaults to 465 for SSL, 587 for TLS).
# Source: 465 (SSL) or 587 (TLS/STARTTLS).
SMTP_PORT=465
EMAIL_PORT=465

# SMTP_SECURE / EMAIL_SECURE: Boolean flag for SSL encryption.
# Usage: 'true' for port 465 (SSL), 'false' for port 587 (STARTTLS).
# Status: Optional (Defaults to true when port is 465).
SMTP_SECURE=true
EMAIL_SECURE=true

# SMTP_USER / EMAIL_USER: SMTP account username or email address.
# Usage: Authenticates email sending.
# Status: Required if email notifications / OTP are enabled.
# Source: Your sending email address (e.g. 'orders@m20fragrance.com' or Gmail address).
SMTP_USER=your_email@gmail.com
EMAIL_USER=your_email@gmail.com

# SMTP_PASSWORD / EMAIL_PASS: SMTP password or App-Specific Password.
# Usage: Authenticates email sending.
# Status: Required if SMTP_USER / EMAIL_USER is set.
# Source: For Gmail: Google Account -> Security -> 2-Step Verification -> App Passwords (16-character code).
#         For custom SMTP: Generated SMTP API password.
SMTP_PASSWORD=your_app_specific_password_here
EMAIL_PASS=your_app_specific_password_here

# EMAIL_FROM_NAME: Display name of the sender.
# Usage: Displayed as sender name in customer inboxes (e.g. 'M20').
EMAIL_FROM_NAME=M20

# EMAIL_FROM_ADDRESS: Display email address of the sender.
# Usage: Displayed as sender email in customer inboxes (e.g. 'orders@m20fragrance.com').
EMAIL_FROM_ADDRESS=orders@m20fragrance.com

# EMAIL_FROM: Combined format header string.
# Usage: Overrides EMAIL_FROM_NAME/ADDRESS if explicitly provided.
# Status: Optional.
EMAIL_FROM="M20 Maison" <orders@m20fragrance.com>

# ------------------------------------------------------------------------------
# 7. AUTOMATED CLEANUP & RETENTION POLICIES
# ------------------------------------------------------------------------------
# PAYMENT_PROOF_RETENTION_DAYS: Number of days to retain customer transfer payment receipts.
# Usage: Customer transfer receipts (Vodafone Cash / InstaPay screenshots) are automatically
#        deleted from Cloudinary and cleared from orders 30 days after admin confirmation.
#        The complete order, payment status, verifiedAt, and financial audit records are retained.
#        IMPORTANT: Purchase raw material invoice attachments (Purchase.attachmentUrl) are
#        permanently preserved and strictly excluded from this automatic deletion.
# Status: Optional (Defaults to 30 days).
PAYMENT_PROOF_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 8. SHIPPING & LOGISTICS DEFAULTS
# ------------------------------------------------------------------------------
# METRO_PICKUP_FEE: Default customer fee for Cairo Metro station delivery pickup.
# Usage: Fallback metro delivery charge if not customized in Admin Settings.
# Status: Optional (Defaults to 0 for free pickup).
# Source: Number in EGP (e.g. 0, 15, 20).
METRO_PICKUP_FEE=0

# STORE_URL: public store URL, used for crawler link previews (/seo/product/:id)
STORE_URL=https://m20fragrance.store
